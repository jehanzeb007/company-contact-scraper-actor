{
  "actorSpecification": 1,
  "name": "company-contact-scraper",
  "title": "Company Contact Scraper",
  "description": "Scrapes company contact details from Google Maps, including phone, website, address, location metadata, opening hours, ratings, and review distribution. One dataset row is produced per company/place.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 2048,
  "defaultMemoryMbytes": 4096,
  "maxMemoryMbytes": 8192,
  "environmentVariables": {},
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Company Contacts",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "searchString",
              "title",
              "categoryName",
              "website",
              "phone",
              "phoneUnformatted",
              "address",
              "city",
              "state",
              "countryCode",
              "totalScore",
              "reviewsCount",
              "reviewsDistribution",
              "placeId",
              "cid",
              "url",
              "scrapedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "searchString": { "label": "Search input", "format": "text" },
              "title": { "label": "Place name", "format": "text" },
              "categoryName": { "label": "Category", "format": "text" },
              "website": { "label": "Website", "format": "link" },
              "phone": { "label": "Phone", "format": "text" },
              "phoneUnformatted": { "label": "Phone normalized", "format": "text" },
              "address": { "label": "Address", "format": "text" },
              "city": { "label": "City", "format": "text" },
              "state": { "label": "State", "format": "text" },
              "countryCode": { "label": "Country", "format": "text" },
              "totalScore": { "label": "Rating", "format": "number" },
              "reviewsCount": { "label": "Reviews", "format": "number" },
              "reviewsDistribution": { "label": "Review stars", "format": "object" },
              "placeId": { "label": "Place ID", "format": "text" },
              "cid": { "label": "CID", "format": "text" },
              "url": { "label": "Google Maps URL", "format": "link" },
              "scrapedAt": { "label": "Scraped at", "format": "date" }
            }
          }
        }
      }
    }
  }
}
